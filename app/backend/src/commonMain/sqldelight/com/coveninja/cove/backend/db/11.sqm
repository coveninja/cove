-- Trakt's session table becomes a per-provider one so a second tracker can share it.
-- The copy runs before the drop: these rows are live OAuth tokens, and losing them
-- silently signs the viewer out of an account they never asked to leave.
CREATE TABLE tracker_sessions (
    profile_id TEXT NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
    provider TEXT NOT NULL,
    access_token TEXT NOT NULL,
    refresh_token TEXT NOT NULL DEFAULT '',
    expires_at INTEGER NOT NULL DEFAULT 0,
    username TEXT NOT NULL DEFAULT '',
    last_sync_at TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (profile_id, provider)
);

INSERT INTO tracker_sessions(
    profile_id, provider, access_token, refresh_token, expires_at, username, last_sync_at
)
SELECT profile_id, 'trakt', access_token, refresh_token, expires_at, username, last_sync_at
FROM trakt_sessions;

DROP TABLE trakt_sessions;

CREATE TABLE external_id_map (
    source TEXT NOT NULL,
    external_id TEXT NOT NULL,
    media_type TEXT NOT NULL,
    tmdb_id INTEGER NOT NULL,
    PRIMARY KEY (source, external_id, media_type)
);
