<?xml version="1.0" encoding="utf-8"?>
<!-- Dark background with a simplified broken-image glyph (frame + landscape +
     diagonal crack) in #A1A1A1. Rendered when Coil fails to load a poster. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="110dp"
    android:height="165dp"
    android:viewportWidth="110"
    android:viewportHeight="165">

    <!-- Background -->
    <path
        android:fillColor="#171717"
        android:pathData="M0,0H110V165H0Z"/>

    <!-- Image-frame outline centered at (55, 82), ~46×38 units -->
    <path
        android:strokeColor="#A1A1A1"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M32,63H78V101H32Z"/>

    <!-- Mountain landscape filling the lower portion of the frame -->
    <path
        android:fillColor="#A1A1A1"
        android:pathData="M32,101L46,82L57,91L66,77L78,101Z"/>

    <!-- Sun/circle in the upper-right area of the frame (cx=67, cy=72, r=5) -->
    <path
        android:fillColor="#A1A1A1"
        android:pathData="M67,72m-5,0a5,5,0,1,0,10,0a5,5,0,1,0,-10,0"/>

    <!-- Diagonal crack in background color, simulating a broken/torn image -->
    <path
        android:strokeColor="#171717"
        android:strokeWidth="2.5"
        android:pathData="M41,63L33,101"/>

</vector>
