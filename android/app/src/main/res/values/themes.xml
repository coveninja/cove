<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Framework NoActionBar theme — the WebView/mpv UI manages its own
        appearance, so the window must not impose a platform ActionBar.
        Using android:Theme.* avoids a compile-time dependency on the Material
        Components or AppCompat libraries (neither is in our dependency set).
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
