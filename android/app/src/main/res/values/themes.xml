<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Framework NoActionBar theme — Compose manages its own Material3 surface
        hierarchy, so the window must not impose a platform ActionBar.
        Using android:Theme.* avoids a compile-time dependency on the Material
        Components or AppCompat libraries (neither is in our dependency set).
        The actual Material3 theming is applied in Kotlin via MaterialTheme {}.
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
