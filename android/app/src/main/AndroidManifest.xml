<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET is required even for loopback TCP: OkHttp and the Go net stack
        both go through the normal socket path regardless of destination address.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        FOREGROUND_SERVICE is required to call startForegroundService() at all
        (API 28+). FOREGROUND_SERVICE_MEDIA_PLAYBACK is required to declare
        foregroundServiceType="mediaPlayback" (API 34+). POST_NOTIFICATIONS
        is required to show the persistent notification (API 33+); requested
        at runtime in WebViewActivity — denied permission just hides the notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        REQUEST_INSTALL_PACKAGES is required for PackageInstaller to commit a
        session. The system enforces the "install unknown apps" per-source grant
        at install time; this permission just unlocks the API. On first use the
        system prompts the user; subsequent self-updates are silent on API 31+
        once Cove becomes its own installer-of-record.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Android TV: leanback is declared not-required so one APK installs on
        both phones and TVs; touchscreen not-required is mandatory for TV
        devices to pass install-time feature filtering.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".CoveApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            WebViewActivity: the app launcher. Hosts the Svelte UI in a WebView
            that talks to the embedded Go backend on http://127.0.0.1:6969.
            android:exported must be true for any Activity with a LAUNCHER
            intent-filter at targetSdk 31+; AGP 8 / lint enforces this.
        -->
        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Same activity doubles as the Android TV entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            CoveService: foreground media-playback service that owns the Go backend.
            foregroundServiceType="mediaPlayback" is required for API 34 when
            startForeground() passes FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK.
        -->
        <service
            android:name=".service.CoveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Receives PackageInstaller commit status callbacks (STATUS_PENDING_USER_ACTION,
            STATUS_SUCCESS, failure codes). Targeted via explicit component from
            WebViewActivity so no intent-filter is needed. Not exported — only
            this app's PendingIntent can trigger it.
        -->
        <receiver
            android:name=".updater.PackageInstallerReceiver"
            android:exported="false" />

        <!--
            Fires after a self-update installs successfully. ACTION_MY_PACKAGE_REPLACED
            is exempt from background-broadcast restrictions (it is in the allowed-list
            documented in the Android docs). Not exported — the OS delivers it directly.
        -->
        <receiver
            android:name=".updater.PostUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
