<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET is required even for loopback TCP: OkHttp and the Go net stack
        both go through the normal socket path regardless of destination address.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        FOREGROUND_SERVICE is required to call startForegroundService() at all
        (API 28+). FOREGROUND_SERVICE_MEDIA_PLAYBACK is required to declare
        foregroundServiceType="mediaPlayback" (API 34+). POST_NOTIFICATIONS
        is required to show the persistent notification (API 33+); requested
        at runtime in WebViewActivity — denied permission just hides the notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CoveApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            WebViewActivity: the app launcher. Hosts the Svelte UI in a WebView
            that talks to the embedded Go backend on http://127.0.0.1:6969.
            android:exported must be true for any Activity with a LAUNCHER
            intent-filter at targetSdk 31+; AGP 8 / lint enforces this.
        -->
        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            CoveService: foreground media-playback service that owns the Go backend.
            foregroundServiceType="mediaPlayback" is required for API 34 when
            startForeground() passes FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK.
        -->
        <service
            android:name=".service.CoveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
