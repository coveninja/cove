{
  "name": "cove-web",
  "version": "0.31.3",
  "description": "Cove frontend (Svelte + TypeScript), served by the Qt shell.",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy globalVariable,baseLocale",
    "i18n:audit": "node ./scripts/i18n-audit.mjs",
    "i18n:coverage": "node ./scripts/i18n-audit.mjs --write-readme",
    "pretest": "npm run i18n:compile",
    "precheck": "npm run i18n:compile",
    "prelint": "npm run i18n:compile",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run i18n:audit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "animejs": "^4.4.1",
    "hls.js": "^1.6.16",
    "lucide-svelte": "^1.0.1",
    "mode-watcher": "^1.1.0",
    "vidstack": "^1.15.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/svelte": "^5.2.2",
    "@inlang/paraglide-js": "^2.22.0",
    "@inlang/plugin-m-function-matcher": "^2.2.6",
    "@inlang/plugin-message-format": "^4.4.0",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.26.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "jsdom": "^29.1.1",
    "layerchart": "^2.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.4.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
